{
  "name": "dsh-computer-use",
  "version": "0.1.0",
  "private": true,
  "description": "Computer use for DeepSeek Harness on macOS: screenshots, mouse and keyboard control through a compiled CoreGraphics helper. 让 Agent 真正操作这台 Mac：截图、移动/点击鼠标、打字与快捷键。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "native/ComputerUse.swift",
    "native/CUInput.swift",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "assets/screenshots/*.png",
    "screenshots.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "automation",
    "macos"
  ],
  "license": "MIT"
}
